---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

const SITE = Astro.site ?? new URL('https://the-quetta-tea-20.vercel.app');
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL('/media/gallery-2.jpg', SITE).href;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="rooftop cafe Barkat Market, cafe in Garden Town Lahore, best chai in Lahore, karak chai, late night food Lahore, desi food Barkat Market, food deals Lahore, birthday venue Lahore, The Quetta Tea 20, QT20 Lahore" />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="The Quetta Tea 20" />
		<meta property="og:locale" content="en_PK" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<!-- Self-hosted fonts (declared in global.css). Preload the two used above
		     the fold: Inter (body) and Playfair Display 900 (hero headline). -->
		<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/playfair-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />

		<!-- JSON-LD Schema -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FoodEstablishment",
				"name": "The Quetta Tea 20",
				"alternateName": "QT20",
				"image": "https://the-quetta-tea-20.vercel.app/media/gallery-2.jpg",
				"@id": "https://the-quetta-tea-20.vercel.app/",
				"url": "https://the-quetta-tea-20.vercel.app/",
				"telephone": "+923149998804",
				"sameAs": [
					"https://instagram.com/thequetta_tea20",
					"https://www.foodpanda.pk/restaurant/wzu0/the-quetta-tea-20-wzu0"
				],
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "30 Civic Centre, Barkat Market, New Garden Town",
					"addressLocality": "Lahore",
					"addressRegion": "Punjab",
					"postalCode": "54600",
					"addressCountry": "PK"
				},
				"areaServed": ["Barkat Market", "Garden Town", "New Garden Town", "Lahore"],
				"keywords": "rooftop cafe, chai, karak, parathas, burgers, pizza, desi food, late night food, Barkat Market, Garden Town, Lahore",
				"acceptsReservations": true,
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": 31.5048,
					"longitude": 74.3256
				},
				"openingHoursSpecification": {
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": [
						"Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
					],
					"opens": "16:30",
					"closes": "03:00"
				},
				"servesCuisine": ["Pakistani", "Chinese", "Continental", "Tea House"],
				"priceRange": "Rs. 30 - Rs. 2050",
				"hasMap": "https://maps.google.com/?cid=10502328263742130034",
				"potentialAction": {
					"@type": "OrderAction",
					"target": "https://www.foodpanda.pk/restaurant/wzu0/the-quetta-tea-20-wzu0",
					"deliveryMethod": "http://purl.org/goodrelations/v1#DeliveryModeOwnFleet"
				},
				"hasMenu": {
					"@type": "Menu",
					"hasMenuSection": [
						{
							"@type": "MenuSection",
							"name": "Teas",
							"hasMenuItem": [
								{ "@type": "MenuItem", "name": "Quetta Tea", "offers": { "@type": "Offer", "price": "250", "priceCurrency": "PKR" } },
								{ "@type": "MenuItem", "name": "Zafrani Tea", "offers": { "@type": "Offer", "price": "250", "priceCurrency": "PKR" } },
								{ "@type": "MenuItem", "name": "Chocolate Tea", "offers": { "@type": "Offer", "price": "280", "priceCurrency": "PKR" } }
							]
						},
						{
							"@type": "MenuSection",
							"name": "Pizza",
							"hasMenuItem": [
								{ "@type": "MenuItem", "name": "Chicken Tikka Pizza", "offers": { "@type": "Offer", "price": "550-1550", "priceCurrency": "PKR" } }
							]
						},
						{
							"@type": "MenuSection",
							"name": "Chinese",
							"hasMenuItem": [
								{ "@type": "MenuItem", "name": "Manchurian Chicken", "offers": { "@type": "Offer", "price": "499-799", "priceCurrency": "PKR" } }
							]
						},
						{
							"@type": "MenuSection",
							"name": "Karahi",
							"hasMenuItem": [
								{ "@type": "MenuItem", "name": "Chicken White Karahi", "offers": { "@type": "Offer", "price": "1100-2050", "priceCurrency": "PKR" } }
							]
						}
					]
				},
				"amenityFeature": [
					{ "@type": "LocationFeatureSpecification", "name": "Rooftop Seating", "value": true },
					{ "@type": "LocationFeatureSpecification", "name": "Live Music", "value": true }
				]
			}
		</script>
	<link rel="sitemap" href="/sitemap.xml" />
	</head>
	<body class="bg-background text-on-surface font-body">
		<slot />
	</body>
</html>
