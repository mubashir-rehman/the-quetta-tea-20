---
import Layout from '../layouts/Layout.astro';
import { MENU_CATEGORIES, DEALS } from '../data/menu';
import GalleryCarousel from '../components/GalleryCarousel.astro';
---

<Layout title="The Quetta Tea 20 (QT20) | Best Rooftop Tea in Barkat Market, Lahore" description="Chai, Music, and Rooftop Vibes. Experience the best Matka Chai and Parathas at The Quetta Tea 20 in Barkat Market, Lahore. Open late night.">
	<div class="min-h-screen flex flex-col">
		<!-- Navigation -->
		<nav id="navbar" class="fixed top-0 w-full z-50 transition-all duration-300 bg-transparent py-6">
			<div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
				<div class="text-2xl font-black text-amber-400 tracking-tighter">THE QUETTA TEA 20</div>
				
					<div class="hidden md:flex items-center gap-10">
						<a href="#deals" class="text-amber-400 font-bold border-b-2 border-amber-400 pb-1">Deals</a>
						<a href="#menu" class="text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium">Menu</a>
						<a href="#experience" class="text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium">The Vibe</a>
						<a href="#find-us" class="text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium">Find Us</a>
						<a href="https://wa.me/923149998804" class="border border-amber-400 text-amber-400 px-6 py-2 rounded-full font-bold hover:bg-amber-400 hover:text-[#402d00] transition-all">
							WhatsApp Order
						</a>
					</div>

				<button id="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu" class="md:hidden text-[#e5e2e1]">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
				</button>
			</div>

			<!-- Mobile Menu -->
			<div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-[#131313]/95 backdrop-blur-2xl border-b border-white/5 py-10 px-8 space-y-8 shadow-2xl animate-fade-in">
				<a href="#deals" class="mobile-link block text-2xl font-black text-amber-400 tracking-tighter">DEALS</a>
				<a href="#menu" class="mobile-link block text-2xl font-black text-[#d4c5ab] tracking-tighter">MENU</a>
				<a href="#experience" class="mobile-link block text-2xl font-black text-[#d4c5ab] tracking-tighter">THE VIBE</a>
				<a href="#find-us" class="mobile-link block text-2xl font-black text-[#d4c5ab] tracking-tighter">FIND US</a>
				<a href="https://wa.me/923149998804" class="mobile-link block text-2xl font-black text-amber-400 tracking-tighter border-t border-white/5 pt-8">WHATSAPP ORDER</a>
			</div>
		</nav>

		<main>
			<!-- Hero Section -->
			<section class="relative h-screen flex items-center justify-center overflow-hidden">
				<div class="absolute inset-0 z-0 bg-[#0a0a0a]">
					<img
						src="/media/gallery-2.webp"
						alt="The Quetta Tea 20 rooftop cafe at Barkat Market, Lahore"
						width="1400" height="1750"
						fetchpriority="high" decoding="async"
						class="w-full h-full object-cover"
					/>
					<div class="absolute inset-0 hero-gradient"></div>
				</div>
				
				<div class="relative z-10 text-center px-6 max-w-4xl">
					<h1 class="text-6xl md:text-8xl font-black text-[#ffe2ab] leading-tight tracking-tighter mb-6 opacity-0 translate-y-8 animate-fade-in">
						Chai, Music, and Rooftop Vibes
					</h1>
					<p class="text-xl md:text-2xl text-[#d4c5ab] font-light tracking-wide max-w-2xl mx-auto opacity-0 translate-y-8 animate-fade-in-delay">
						Experience the nostalgic atmosphere of Barkat Market's best open-air rooftop, featuring legendary NFAK melodies.
					</p>
					<div class="mt-12 flex flex-wrap justify-center gap-4 opacity-0 scale-95 animate-scale-in">
						<a href="#menu" class="inline-flex items-center gap-2 bg-gradient-to-br from-[#ffbf00] to-[#ffe2ab] text-[#402d00] px-10 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-[#ffbf00]/20 transition-all active:scale-95">
							Explore the Menu
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
						</a>
						<a href="https://maps.google.com/?cid=10502328263742130034&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#2a2a2a] text-[#e5e2e1] px-10 py-4 rounded-full font-bold text-lg border border-white/10 hover:bg-[#353535] transition-all active:scale-95">
							Get Directions
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
						</a>
					</div>
				</div>
			</section>

			<!-- Deals Section -->
			<section id="deals" class="py-24 bg-[#0e0e0e] px-6">
				<div class="max-w-7xl mx-auto">
					<div class="text-center mb-14">
						<span class="text-[#bbcbb8] tracking-[0.3em] uppercase text-sm font-bold">Best Value</span>
						<h2 class="text-5xl font-bold mt-2">Deals @ Rs. 999</h2>
						<p class="text-[#d4c5ab] mt-4 max-w-xl mx-auto">Six loaded combos, one flat price. Pick your favourite and order in seconds on WhatsApp.</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
						{DEALS.map((deal) => {
							const orderText = encodeURIComponent(`Assalam-o-Alaikum! I'd like to order ${deal.name} (Rs. ${deal.price}).`);
							const dealTitle = deal.name.split(':')[1]?.trim() ?? deal.name;
							const dealTag = deal.name.split(':')[0]?.trim();
							return (
								<div class="group flex flex-col bg-[#1c1b1b] rounded-3xl overflow-hidden border border-white/5 hover:border-[#ffe2ab]/30 transition-all shadow-lg">
									<div class="relative aspect-[4/3] bg-[#0a0a0a] overflow-hidden">
										<img
											src={deal.image}
											alt={deal.name}
											width="600" height="450"
											loading="lazy" decoding="async"
											class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
										/>
										<div class="absolute top-4 right-4 bg-[#ffbf00] text-[#402d00] font-black text-lg px-4 py-2 rounded-full shadow-lg">
											Rs. {deal.price}
										</div>
										{dealTag && (
											<div class="absolute top-4 left-4 bg-black/60 backdrop-blur-sm text-[#ffe2ab] text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full">
												{dealTag}
											</div>
										)}
									</div>
									<div class="flex flex-col flex-1 p-6">
										<h3 class="text-2xl text-[#ffe2ab] font-bold mb-4">{dealTitle}</h3>
										<ul class="space-y-2 mb-6 flex-1">
											{deal.items.map((item) => (
												<li class="flex items-start gap-2 text-[#d4c5ab] text-sm">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffbf00" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
													<span>{item}</span>
												</li>
											))}
										</ul>
										<a
											href={`https://wa.me/923149998804?text=${orderText}`}
											target="_blank" rel="noopener noreferrer"
											class="mt-auto inline-flex items-center justify-center gap-2 bg-gradient-to-br from-[#ffbf00] to-[#ffe2ab] text-[#402d00] px-6 py-3 rounded-full font-bold hover:shadow-lg hover:shadow-[#ffbf00]/20 transition-all active:scale-95"
										>
											<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
											Order on WhatsApp
										</a>
									</div>
								</div>
							);
						})}
					</div>
				</div>
			</section>

			<GalleryCarousel />

			<!-- Menu Section -->
			<section id="menu" class="py-24 bg-[#131313] px-6">
				<div class="max-w-7xl mx-auto">
					<div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
						<div>
							<span class="text-[#bbcbb8] tracking-[0.3em] uppercase text-sm font-bold">The Selection</span>
							<h2 class="text-5xl font-bold mt-2">Our Menu</h2>
						</div>
						<div class="flex flex-wrap gap-2 overflow-x-auto pb-2 no-scrollbar" id="category-filters">
							{MENU_CATEGORIES.map(cat => (
								<button 
									data-category={cat.name}
									class={`category-btn whitespace-nowrap px-6 py-2 rounded-full text-sm font-bold transition-all border ${cat.name === MENU_CATEGORIES[0].name ? 'bg-[#ffe2ab] text-[#402d00] border-[#ffe2ab]' : 'bg-[#1c1b1b] text-[#d4c5ab] border-white/5 hover:border-[#ffe2ab]/40'}`}
								>
									{cat.name}
								</button>
							))}
						</div>
					</div>

					<div id="menu-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{MENU_CATEGORIES[0].items.map((item) => (
							<div class="menu-item glass-card p-6 rounded-2xl border border-white/5 hover:border-[#ffe2ab]/20 transition-all group">
								<div class="flex justify-between items-start gap-4 mb-2">
									<h3 class="text-xl text-[#ffe2ab] font-bold group-hover:text-amber-400 transition-colors">{item.name}</h3>
									{item.prices ? (
										<div class="flex gap-4 text-[10px] uppercase tracking-tighter text-amber-400/80 font-bold shrink-0">
											{Object.entries(item.prices).map(([size, amount]) => (
												<div class="flex flex-col items-center"><span>{size}</span><span class="text-amber-400 text-sm">{amount}</span></div>
											))}
										</div>
									) : (
										<span class="text-amber-400 font-bold whitespace-nowrap shrink-0">Rs. {item.price}</span>
									)}
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Experience Section -->
			<section id="experience" class="w-full bg-[#0e0e0e] overflow-hidden">
				<div class="flex flex-col md:flex-row h-auto md:h-[80vh]">
					<div class="w-full md:w-1/2 relative group h-[500px] md:h-full">
						<img
							src="/media/gallery-3.webp"
							alt="Nostalgic Vibes"
							width="1400" height="1050"
							loading="lazy" decoding="async"
							class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-all duration-1000"
						/>
						<div class="absolute inset-0 flex flex-col justify-end p-12 bg-gradient-to-t from-[#131313] to-transparent">
							<h4 class="text-4xl font-bold mb-4">Legendary Melodies</h4>
							<p class="text-[#d4c5ab] max-w-md">Immerse yourself in the soulful NFAK playlist that defines our nostalgic rooftop atmosphere.</p>
						</div>
					</div>
					<div class="w-full md:w-1/2 relative group h-[500px] md:h-full">
						<img
							src="/media/gallery-1.webp"
							alt="Rooftop Seating"
							width="1400" height="1050"
							loading="lazy" decoding="async"
							class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-all duration-1000"
						/>
						<div class="absolute inset-0 flex flex-col justify-end p-12 bg-gradient-to-t from-[#131313] to-transparent">
							<h4 class="text-4xl font-bold mb-4">Barkat Market Views</h4>
							<p class="text-[#d4c5ab] max-w-md">The best open-air rooftop experience in Lahore's most vibrant food hub.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Service Philosophy -->
			<section class="py-24 bg-[#131313] text-center px-6">
				<div class="max-w-4xl mx-auto border-y border-white/5 py-16">
					<h2 class="text-3xl mb-12 italic text-[#d4c5ab] font-headline">Service Philosophy</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
						<div class="flex flex-col items-center gap-4">
							<div class="w-16 h-16 rounded-full bg-[#2a2a2a] flex items-center justify-center border border-[#ffe2ab]/20">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path><path d="M7 2v20"></path><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path></svg>
							</div>
							<h3 class="font-bold text-xl uppercase tracking-widest">Eat-In</h3>
							<p class="text-[#d4c5ab] text-sm">Experience the full ambiance of our nocturnal gallery with table service.</p>
						</div>
						<div class="flex flex-col items-center gap-4">
							<div class="w-16 h-16 rounded-full bg-[#2a2a2a] flex items-center justify-center border border-[#ffe2ab]/20">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
							</div>
							<h3 class="font-bold text-xl uppercase tracking-widest">Takeaway</h3>
							<p class="text-[#d4c5ab] text-sm">Perfectly packaged urban bites to enjoy on the move. Pre-order via WhatsApp.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Find Us Section -->
			<section id="find-us" class="py-24 bg-[#1c1b1b] px-6">
				<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
					<div class="space-y-8">
						<div>
							<span class="text-[#f59e0b] tracking-[0.3em] uppercase text-sm font-bold">Visit Us</span>
							<h2 class="text-5xl font-bold mt-2">Find Your Corner</h2>
						</div>
						<div class="space-y-6">
							<div class="flex gap-4">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
								<div>
									<p class="font-bold text-lg">30 Civic Center, Barkat Market</p>
									<p class="text-[#d4c5ab]">Garden Town, Lahore, Pakistan</p>
								</div>
							</div>
							<div class="flex gap-4">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.27-2.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
								<div>
									<p class="font-bold text-lg">Contact Us</p>
									<p class="text-[#d4c5ab]">0314-9998804</p>
								</div>
							</div>
							<div class="flex gap-4">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
								<div>
									<p class="font-bold text-lg">Open Daily</p>
									<p class="text-[#d4c5ab]">12:00 PM — 2:00 AM (Next Day)</p>
								</div>
							</div>
							<div class="flex gap-4">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 12v10H4V12"></path><path d="M2 7h20v5H2z"></path><path d="M12 22V7"></path><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
								<div>
									<p class="font-bold text-lg">Birthdays & Events</p>
									<p class="text-[#d4c5ab]">Decor + rooftop seating for up to 50 guests. Message us on WhatsApp to book.</p>
								</div>
							</div>
							<div class="flex gap-6 pt-4">
								<a href="https://instagram.com/thequettatea20" target="_blank" rel="noopener noreferrer" aria-label="The Quetta Tea 20 on Instagram" class="text-[#d4c5ab] hover:text-[#ffe2ab] transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
								</a>
								<a href="https://wa.me/923149998804" aria-label="Order from The Quetta Tea 20 on WhatsApp" class="text-[#d4c5ab] hover:text-[#ffe2ab] transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
								</a>
								<a href="https://maps.google.com/?cid=10502328263742130034&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNl" target="_blank" rel="noopener noreferrer" aria-label="Find The Quetta Tea 20 on Google Maps" class="text-[#d4c5ab] hover:text-[#ffe2ab] transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
								</a>
							</div>
						</div>
					</div>
					<div class="rounded-3xl overflow-hidden h-[450px] shadow-2xl grayscale contrast-125 border border-white/5 relative group">
						<img 
							src="https://lh3.googleusercontent.com/aida-public/AB6AXuBxfsV5wWx2idmIjCYev0KOGs1x1nYJVop_VmsKdVSEnuJeJ5Pvhk9vzuxn6YeeiKfxDUSjXGQ5jDN1aQgSr2gerdbYG-ZGF4tgOLYsENutmCXfSMxBF3iYc_pt6IB8HbNvC7dAwdzAaPIq1af0CK92gEB4m9I2ZvBfec7A6y1O3NGSNLOfq_n1cyBsDdUECA_dXWEEyRC8J9OioE9OrUohfpd6qRVw907cK3GChxDTm0PS5g2_eSBEXeK2PDfzi9btp10MxprQoQQ" 
							alt="The Quetta Tea 20 location on the map"
							width="700" height="450"
							loading="lazy" decoding="async"
							class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
						/>
						<div class="absolute inset-0 bg-black/40 flex items-center justify-center">
							<a 
								href="https://maps.google.com/?cid=10502328263742130034&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNl" 
								target="_blank" 
								rel="noopener noreferrer"
								class="bg-[#131313] px-8 py-4 rounded-full border border-[#ffe2ab]/40 text-[#ffe2ab] font-bold hover:bg-[#ffe2ab] hover:text-[#402d00] transition-all shadow-2xl"
							>
								Get Directions
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="bg-[#131313] py-16 border-t border-white/5 px-6">
			<div class="max-w-7xl mx-auto flex flex-col items-center gap-8">
				<div class="text-2xl font-black text-[#e5e2e1] tracking-tighter">THE QUETTA TEA 20</div>
