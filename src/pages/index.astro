---
import Layout from '../layouts/Layout.astro';
import { MENU_CATEGORIES, DEALS } from '../data/menu';
import { REVIEWS } from '../data/reviews';
import GalleryCarousel from '../components/GalleryCarousel.astro';

const slugify = (s) =>
	s.toLowerCase().replace(/[()]/g, ' ').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Layout title="The Quetta Tea 20 | Rooftop Cafe & Chai in Barkat Market, Lahore" description="Rooftop cafe in Barkat Market, Garden Town, Lahore. Quetta chai & karak, parathas, burgers, pizza, karahi & desi food. Open late (4:30 PM–3 AM), dine-in, Foodpanda delivery & Rs.999 deals.">
	<div class="min-h-screen flex flex-col">
		<!-- Navigation -->
		<nav id="navbar" class="fixed top-0 w-full z-50 transition-all duration-300 bg-transparent py-6">
			<div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
				<div class="text-2xl font-black text-amber-400 tracking-tighter">THE QUETTA TEA 20</div>
				
					<div class="hidden md:flex items-center gap-10">
						<a href="#deals" data-nav="deals" class="nav-link text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium border-b-2 border-transparent pb-1">Deals</a>
						<a href="#menu" data-nav="menu" class="nav-link text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium border-b-2 border-transparent pb-1">Menu</a>
						<a href="#experience" data-nav="experience" class="nav-link text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium border-b-2 border-transparent pb-1">The Vibe</a>
						<a href="#reviews" data-nav="reviews" class="nav-link text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium border-b-2 border-transparent pb-1">Reviews</a>
						<a href="#find-us" data-nav="find-us" class="nav-link text-[#d4c5ab] hover:text-[#e5e2e1] transition-colors font-medium border-b-2 border-transparent pb-1">Find Us</a>
						<a href="https://wa.me/923149998804" class="border border-amber-400 text-amber-400 px-6 py-2 rounded-full font-bold hover:bg-amber-400 hover:text-[#402d00] transition-all">
							WhatsApp Order
						</a>
					</div>

				<button id="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu" class="md:hidden text-[#e5e2e1]">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
				</button>
			</div>

			<!-- Mobile Menu -->
			<div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-[#131313]/95 backdrop-blur-2xl border-b border-white/5 py-10 px-8 space-y-8 shadow-2xl animate-fade-in">
				<a href="#deals" class="mobile-link block text-2xl font-black text-amber-400 tracking-tighter">DEALS</a>
				<a href="#menu" class="mobile-link block text-2xl font-black text-[#d4c5ab] tracking-tighter">MENU</a>
				<a href="#experience" class="mobile-link block text-2xl font-black text-[#d4c5ab] tracking-tighter">THE VIBE</a>
				<a href="#reviews" class="mobile-link block text-2xl font-black text-[#d4c5ab] tracking-tighter">REVIEWS</a>
				<a href="#find-us" class="mobile-link block text-2xl font-black text-[#d4c5ab] tracking-tighter">FIND US</a>
				<a href="https://wa.me/923149998804" class="mobile-link block text-2xl font-black text-amber-400 tracking-tighter border-t border-white/5 pt-8">WHATSAPP ORDER</a>
			</div>
		</nav>

		<main>
			<!-- Hero Section -->
			<section class="relative h-screen flex items-center justify-center overflow-hidden">
				<div class="absolute inset-0 z-0 bg-[#0a0a0a]">
					<img
						src="/media/gallery-2.webp"
						alt="The Quetta Tea 20 rooftop cafe at Barkat Market, Lahore"
						width="1400" height="1050"
						fetchpriority="high" decoding="async"
						class="w-full h-full object-cover"
					/>
					<div class="absolute inset-0 hero-gradient"></div>
				</div>
				
				<div class="relative z-10 text-center px-6 max-w-4xl">
					<h1 class="text-6xl md:text-8xl font-black text-[#ffe2ab] leading-tight tracking-tighter mb-6">
						Chai, Music, and Rooftop Vibes
					</h1>
					<p class="text-xl md:text-2xl text-[#d4c5ab] font-light tracking-wide max-w-2xl mx-auto">
						Experience the nostalgic atmosphere of Barkat Market's best open-air rooftop, featuring legendary NFAK melodies.
					</p>
					<div class="mt-12 flex flex-wrap justify-center gap-4">
						<a href="https://www.foodpanda.pk/restaurant/wzu0/the-quetta-tea-20-wzu0" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#d70f64] text-white px-10 py-4 rounded-full font-bold text-lg shadow-lg hover:bg-[#c30d59] hover:shadow-[#d70f64]/30 transition-all active:scale-95">
							Order on Foodpanda
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
						</a>
						<a href="#menu" class="inline-flex items-center gap-2 bg-gradient-to-br from-[#ffbf00] to-[#ffe2ab] text-[#402d00] px-10 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-[#ffbf00]/20 transition-all active:scale-95">
							Explore the Menu
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
						</a>
						<a href="https://maps.google.com/?cid=10502328263742130034&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-[#2a2a2a] text-[#e5e2e1] px-10 py-4 rounded-full font-bold text-lg border border-white/10 hover:bg-[#353535] transition-all active:scale-95">
							Get Directions
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
						</a>
					</div>
				</div>
			</section>

			<!-- Deals Section -->
			<section id="deals" class="py-24 bg-[#0e0e0e] px-6">
				<div class="max-w-7xl mx-auto">
					<div class="text-center mb-14">
						<span class="text-[#bbcbb8] tracking-[0.3em] uppercase text-sm font-bold">Best Value</span>
						<h2 class="text-5xl font-bold mt-2">Deals @ Rs. 999</h2>
						<p class="text-[#d4c5ab] mt-4 max-w-xl mx-auto">Six loaded combos, one flat price. Pick your favourite and order in seconds on WhatsApp.</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
						{DEALS.map((deal) => {
							const orderText = encodeURIComponent(`Assalam-o-Alaikum! I'd like to order ${deal.name} (Rs. ${deal.price}).`);
							const dealTitle = deal.name.split(':')[1]?.trim() ?? deal.name;
							const dealTag = deal.name.split(':')[0]?.trim();
							return (
								<div class="group flex flex-col bg-[#1c1b1b] rounded-3xl overflow-hidden border border-white/5 hover:border-[#ffe2ab]/30 transition-all shadow-lg">
									<div class="relative aspect-[4/3] bg-[#0a0a0a] overflow-hidden">
										<img
											src={deal.image}
											alt={deal.name}
											width="600" height="450"
											loading="lazy" decoding="async"
											class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
										/>
										<div class="absolute top-4 right-4 bg-[#ffbf00] text-[#402d00] font-black text-lg px-4 py-2 rounded-full shadow-lg">
											Rs. {deal.price}
										</div>
										{dealTag && (
											<div class="absolute top-4 left-4 bg-black/60 backdrop-blur-sm text-[#ffe2ab] text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full">
												{dealTag}
											</div>
										)}
									</div>
									<div class="flex flex-col flex-1 p-6">
										<h3 class="text-2xl text-[#ffe2ab] font-bold mb-4">{dealTitle}</h3>
										<ul class="space-y-2 mb-6 flex-1">
											{deal.items.map((item) => (
												<li class="flex items-start gap-2 text-[#d4c5ab] text-sm">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffbf00" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
													<span>{item}</span>
												</li>
											))}
										</ul>
										<a
											href={`https://wa.me/923149998804?text=${orderText}`}
											target="_blank" rel="noopener noreferrer"
											class="mt-auto inline-flex items-center justify-center gap-2 bg-gradient-to-br from-[#ffbf00] to-[#ffe2ab] text-[#402d00] px-6 py-3 rounded-full font-bold hover:shadow-lg hover:shadow-[#ffbf00]/20 transition-all active:scale-95"
										>
											<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
											Order on WhatsApp
										</a>
									</div>
								</div>
							);
						})}
					</div>
				</div>
			</section>

			<GalleryCarousel />

			<!-- Menu Section -->
			<section id="menu" class="py-24 bg-[#131313] px-6">
				<div class="max-w-7xl mx-auto">
					<div class="mb-8">
						<span class="text-[#bbcbb8] tracking-[0.3em] uppercase text-sm font-bold">The Selection</span>
						<h2 class="text-5xl font-bold mt-2">Our Menu</h2>
						<p class="text-[#d4c5ab] mt-4 max-w-3xl">From authentic Quetta chai and karak to loaded parathas, burgers, pizza, Chinese, karahi and steaks — our full menu of desi food and refreshments at the best rooftop cafe in Barkat Market, Garden Town, Lahore.</p>
					</div>

					<!-- Sticky quick-jump bar (scroll-spy highlights the current section) -->
					<div class="sticky top-16 z-30 -mx-6 mb-14 px-6 py-3 bg-[#131313]/90 backdrop-blur-md border-y border-white/5">
						<div class="flex gap-2 overflow-x-auto no-scrollbar" id="category-filters">
							{MENU_CATEGORIES.map((cat, i) => (
								<a
									href={`#cat-${slugify(cat.name)}`}
									data-target={`cat-${slugify(cat.name)}`}
									class={`category-btn whitespace-nowrap px-5 py-2 rounded-full text-sm font-bold transition-all border ${i === 0 ? 'bg-[#ffe2ab] text-[#402d00] border-[#ffe2ab]' : 'bg-[#1c1b1b] text-[#d4c5ab] border-white/5 hover:border-[#ffe2ab]/40'}`}
								>
									{cat.name}
								</a>
							))}
						</div>
					</div>

					<!-- All sections stacked (printed-menu / Foodpanda style) -->
					<div class="space-y-16">
						{MENU_CATEGORIES.map((cat) => (
							<section id={`cat-${slugify(cat.name)}`} class="menu-section scroll-mt-36">
								<div class="flex items-center gap-4 mb-6 pb-4 border-b border-white/5">
									<img
										src={cat.image}
										alt={`${cat.name} at The Quetta Tea 20`}
										width="64" height="64"
										loading="lazy" decoding="async" referrerpolicy="no-referrer"
										class="w-14 h-14 rounded-xl object-cover border border-white/10 shrink-0"
										onerror="this.style.display='none'"
									/>
									<h3 class="text-2xl md:text-3xl font-bold text-[#ffe2ab]">{cat.name}</h3>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
									{cat.items.map((item) => (
										<div class="menu-item glass-card p-6 rounded-2xl border border-white/5 hover:border-[#ffe2ab]/20 transition-all group">
											<div class="flex justify-between items-start gap-4 mb-2">
												<h4 class="text-xl text-[#ffe2ab] font-bold group-hover:text-amber-400 transition-colors">{item.name}</h4>
												{item.prices ? (
													<div class="flex gap-4 text-[10px] uppercase tracking-tighter text-amber-400/80 font-bold shrink-0">
														{Object.entries(item.prices).map(([size, amount]) => (
															<div class="flex flex-col items-center"><span>{size}</span><span class="text-amber-400 text-sm">{amount}</span></div>
														))}
													</div>
												) : (
													<span class="text-amber-400 font-bold whitespace-nowrap shrink-0">Rs. {item.price}</span>
												)}
											</div>
										</div>
									))}
								</div>
							</section>
						))}
					</div>
				</div>
			</section>

			<!-- Experience Section -->
			<section id="experience" class="w-full bg-[#0e0e0e] overflow-hidden">
				<div class="flex flex-col md:flex-row h-auto md:h-[80vh]">
					<div class="w-full md:w-1/2 relative group h-[500px] md:h-full">
						<img
							src="/media/gallery-3.webp"
							alt="Nostalgic Vibes"
							width="1400" height="1050"
							loading="lazy" decoding="async"
							class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-all duration-1000"
						/>
						<div class="absolute inset-0 flex flex-col justify-end p-12 bg-gradient-to-t from-[#131313] to-transparent">
							<h3 class="text-4xl font-bold mb-4">Legendary Melodies</h3>
							<p class="text-[#d4c5ab] max-w-md">Immerse yourself in the soulful NFAK playlist that defines our nostalgic rooftop atmosphere.</p>
						</div>
					</div>
					<div class="w-full md:w-1/2 relative group h-[500px] md:h-full">
						<img
							src="/media/gallery-1.webp"
							alt="Rooftop Seating"
							width="1400" height="1050"
							loading="lazy" decoding="async"
							class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-all duration-1000"
						/>
						<div class="absolute inset-0 flex flex-col justify-end p-12 bg-gradient-to-t from-[#131313] to-transparent">
							<h3 class="text-4xl font-bold mb-4">Barkat Market Views</h3>
							<p class="text-[#d4c5ab] max-w-md">The best open-air rooftop experience in Lahore's most vibrant food hub.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Service Philosophy -->
			<section class="py-24 bg-[#131313] text-center px-6">
				<div class="max-w-4xl mx-auto border-y border-white/5 py-16">
					<h2 class="text-3xl mb-12 italic text-[#d4c5ab] font-headline">Service Philosophy</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
						<div class="flex flex-col items-center gap-4">
							<div class="w-16 h-16 rounded-full bg-[#2a2a2a] flex items-center justify-center border border-[#ffe2ab]/20">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path><path d="M7 2v20"></path><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path></svg>
							</div>
							<h3 class="font-bold text-xl uppercase tracking-widest">Eat-In</h3>
							<p class="text-[#d4c5ab] text-sm">Experience the full ambiance of our nocturnal gallery with table service.</p>
						</div>
						<div class="flex flex-col items-center gap-4">
							<div class="w-16 h-16 rounded-full bg-[#2a2a2a] flex items-center justify-center border border-[#ffe2ab]/20">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffe2ab" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
							</div>
							<h3 class="font-bold text-xl uppercase tracking-widest">Takeaway</h3>
							<p class="text-[#d4c5ab] text-sm">Perfectly packaged urban bites to enjoy on the move. Pre-order via WhatsApp.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Testimonials / Social Proof -->
			<section id="reviews" class="py-28 bg-[#131313] px-6">
				<div class="max-w-6xl mx-auto">
					<div class="text-center mb-16">
						<span class="text-[#bbcbb8] tracking-[0.3em] uppercase text-sm font-bold">Loved in Barkat Market</span>
						<h2 class="text-5xl md:text-6xl font-bold mt-3">What Our Guests Say</h2>
						<a
							href="https://maps.google.com/?cid=10502328263742130034&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNl"
							target="_blank" rel="noopener noreferrer"
							class="inline-flex items-center gap-3 mt-6 text-[#d4c5ab] hover:text-[#ffe2ab] transition-colors"
						>
							<span class="flex items-center gap-1 text-[#ffbf00]" aria-hidden="true">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg>
								<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.8V2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8z"/></svg>
							</span>
							<span class="font-semibold">4.0 on Google — read all reviews</span>
						</a>
					</div>

					<div class="swiper reviews-swiper">
						<div class="swiper-wrapper">
							{REVIEWS.map((r) => (
								<div class="swiper-slide h-auto pb-2">
									<figure class="h-full bg-[#1c1b1b] rounded-3xl border border-white/5 p-8 flex flex-col">
										<div class="flex gap-1 text-[#ffbf00] mb-5" aria-label="5 out of 5 stars">
											<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg>
										</div>
										<blockquote class="text-[#e5e2e1] leading-relaxed flex-1">“{r.text}”</blockquote>
										<figcaption class="mt-6 pt-5 border-t border-white/5 flex items-center gap-3">
											<span class="w-11 h-11 rounded-full bg-[#2a2a2a] border border-[#ffe2ab]/20 flex items-center justify-center text-[#ffe2ab] font-bold shrink-0 relative overflow-hidden">
												{r.initial}
												<img src={r.avatar} alt={`${r.name}, Google reviewer`} width="44" height="44" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover" onerror="this.remove()" />
											</span>
											<span>
												<span class="block font-semibold text-[#ffe2ab] not-italic">{r.name}</span>
