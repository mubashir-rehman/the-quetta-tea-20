<script>
	// Navbar scroll effect
	const navbar = document.getElementById('navbar');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 50) {
			navbar.classList.add('bg-[#131313]/80', 'backdrop-blur-xl', 'py-4', 'shadow-xl');
			navbar.classList.remove('bg-transparent', 'py-6');
		} else {
			navbar.classList.remove('bg-[#131313]/80', 'backdrop-blur-xl', 'py-4', 'shadow-xl');
			navbar.classList.add('bg-transparent', 'py-6');
		}
	});

	// Mobile menu toggle
	const menuToggle = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');
	const mobileLinks = document.querySelectorAll('.mobile-link');

	menuToggle.addEventListener('click', () => {
		const isOpen = mobileMenu.classList.toggle('hidden') === false;
		menuToggle.setAttribute('aria-expanded', String(isOpen));
		menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
	});

	mobileLinks.forEach(link => {
		link.addEventListener('click', () => {
			mobileMenu.classList.add('hidden');
			menuToggle.setAttribute('aria-expanded', 'false');
			menuToggle.setAttribute('aria-label', 'Open navigation menu');
		});
	});

	// Top-nav scroll-spy: highlight the nav link for the section currently in view
	const navLinks = Array.from(document.querySelectorAll('.nav-link'));
	const navByTarget = new Map(navLinks.map(a => [a.getAttribute('data-nav'), a]));
	const navSections = navLinks
		.map(a => document.getElementById(a.getAttribute('data-nav')))
		.filter(Boolean);

	function setActiveNav(link) {
		navLinks.forEach(a => {
			a.classList.remove('text-amber-400', 'font-bold', 'border-amber-400');
			a.classList.add('text-[#d4c5ab]', 'font-medium', 'border-transparent');
		});
		if (!link) return;
		link.classList.add('text-amber-400', 'font-bold', 'border-amber-400');
		link.classList.remove('text-[#d4c5ab]', 'font-medium', 'border-transparent');
	}

	if (navSections.length && 'IntersectionObserver' in window) {
		const navObserver = new IntersectionObserver((entries) => {
			entries.forEach(e => {
				if (e.isIntersecting) setActiveNav(navByTarget.get(e.target.id));
			});
		}, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
		navSections.forEach(s => navObserver.observe(s));
	}

	// Menu scroll-spy: highlight the jump-bar chip for the section currently in view
	const jumpLinks = Array.from(document.querySelectorAll('#category-filters .category-btn'));
	const menuSections = Array.from(document.querySelectorAll('.menu-section'));
	const linkByTarget = new Map(jumpLinks.map(a => [a.getAttribute('data-target'), a]));

	function setActiveChip(link) {
		jumpLinks.forEach(b => {
			b.classList.remove('bg-[#ffe2ab]', 'text-[#402d00]', 'border-[#ffe2ab]');
			b.classList.add('bg-[#1c1b1b]', 'text-[#d4c5ab]', 'border-white/5');
		});
		if (!link) return;
		link.classList.add('bg-[#ffe2ab]', 'text-[#402d00]', 'border-[#ffe2ab]');
		link.classList.remove('bg-[#1c1b1b]', 'text-[#d4c5ab]', 'border-white/5');
		link.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
	}

	// Instant feedback on tap; the anchor href handles the smooth scroll
	jumpLinks.forEach(link => link.addEventListener('click', () => setActiveChip(link)));

	if (menuSections.length && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(e => {
				if (e.isIntersecting) setActiveChip(linkByTarget.get(e.target.id));
			});
		}, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
		menuSections.forEach(s => observer.observe(s));
	}
</script>

<script>
	import Swiper from 'swiper';
	import { Pagination, Navigation, Autoplay } from 'swiper/modules';
	import 'swiper/css';
	import 'swiper/css/pagination';

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	new Swiper('.reviews-swiper', {
		modules: [Pagination, Navigation, Autoplay],
		slidesPerView: 1,
		spaceBetween: 24,
		loop: true,
		grabCursor: true,
		autoplay: prefersReduced ? false : { delay: 5500, disableOnInteraction: false, pauseOnMouseEnter: true },
		pagination: { el: '.reviews-pagination', clickable: true },
		navigation: { prevEl: '.reviews-prev', nextEl: '.reviews-next' },
		breakpoints: {
