---
// src/components/GalleryCarousel.astro
---

<section class="py-24 bg-[#0a0a0a] overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 mb-12">
    <span class="text-blue-400 tracking-[0.3em] uppercase text-sm font-bold">Visual Journey</span>
    <h2 class="text-5xl font-bold mt-2 text-white">The Gallery</h2>
  </div>

